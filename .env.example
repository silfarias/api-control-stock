# --- App ---
NODE_ENV=development
PORT=3000

# --- CORS (orígenes del frontend, separados por coma) ---
# Desarrollo: si se omite, se permiten http://localhost:5173 y http://127.0.0.1:5173
# Producción: obligatorio (ej: https://tu-dominio.com). Sin valor no se refleja origen.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
# CORS_CREDENTIALS=true

# --- Body HTTP (json/urlencoded). Default seguro: 1mb (alcanza para /producto/bulk) ---
BODY_LIMIT=1mb

# --- Swagger (/api) ---
# true | false | omitir → habilitado si NODE_ENV !== production
# SWAGGER_ENABLED=false
# SWAGGER_SERVER_URL=https://api.tu-dominio.com/

# --- Rate limiting (opcional) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=control-stock
DB_TIMEZONE=-03:00

# --- JWT ---
# Obligatorios: tokens emitidos por esta API (mín. 16 caracteres en validación de arranque).
ACCESS_TOKEN_SECRET=change-me-min-16-chars-xx
ACCESS_TOKEN_REFRESH_SECRET=change-me-min-16-chars-xx
ACCESS_TOKEN_EXPIRES_IN=1d
ACCESS_TOKEN_REFRESH_EXPIRES_IN=30d

# --- Seed admin (solo bootstrap; SEED_ADMIN_ENABLED=false en producción) ---
SEED_ADMIN_ENABLED=false
SEED_ADMIN_NOMBRE=Silvana
SEED_ADMIN_EMAIL=silvifarias17@gmail.com
SEED_ADMIN_PASSWORD=change-me