# --- App ---
NODE_ENV=development
PORT=3000
# Interfaz de escucha. Desarrollo: 0.0.0.0 (default). Producción detrás de Nginx: 127.0.0.1
# HOST=0.0.0.0

# --- Proxy (Hostinger/Nginx): habilitar para que el rate limit vea la IP real ---
# true | número de hops | false. En VPS detrás de un reverse proxy: true
# TRUST_PROXY=true

# --- CORS (orígenes del frontend, separados por coma) ---
# Desarrollo: si se omite, se permiten http://localhost:5173 y http://127.0.0.1:5173
# Producción: obligatorio (ej: https://tu-dominio.com). Sin valor no se refleja origen.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
# CORS_CREDENTIALS=true

# --- Body HTTP (json/urlencoded). Default seguro: 1mb (alcanza para /producto/bulk) ---
BODY_LIMIT=1mb

# --- Swagger (/api) ---
# true | false | omitir → habilitado si NODE_ENV !== production
# En VPS: SWAGGER_ENABLED=false (o confiar en NODE_ENV=production)
# SWAGGER_ENABLED=false
# SWAGGER_SERVER_URL=https://api.tu-dominio.com/

# --- Rate limiting ---
# Global (APP_GUARD). Auth tiene límites más estrictos abajo.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_REFRESH_LIMIT=15
THROTTLE_SEED_LIMIT=3

# --- MySQL ---
# Desarrollo local: root vía Docker está bien.
# Producción: DB_USERNAME=app_stock (ver scripts/sql/03-mysql-users.sql y docs/mysql-seguridad.md).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=control-stock
DB_TIMEZONE=-03:00
# Esquema: usar migraciones (yarn migration:run). synchronize queda en false.
# Solo desarrollo puntual (nunca production): DB_SYNCHRONIZE=true
# DB_SYNCHRONIZE=false
# SQL de TypeORM en consola: DB_LOGGING=true
# DB_LOGGING=false

# --- Backups (mysqldump → .sql.gz) ---
# Ver docs/backups.md. Local con contenedor: BACKUP_VIA_DOCKER=true
# En VPS sin Docker MySQL: BACKUP_VIA_DOCKER=false
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Copia a almacenamiento externo al VPS (ruta montada / carpeta sync). Opcional.
# BACKUP_EXTERNAL_DIR=/mnt/backups-offsite/control-stock
BACKUP_VIA_DOCKER=true
BACKUP_DOCKER_CONTAINER=control-stock-mysql
# Usuario dedicado de backups (prod). Si se omite, usa DB_USERNAME/DB_PASSWORD.
# BACKUP_DB_USERNAME=backup_stock
# BACKUP_DB_PASSWORD=change-me-backup-only
# Restore a base temporal: cuenta con CREATE DATABASE (root/admin). No usar app_stock.
# RESTORE_DB_USERNAME=root
# RESTORE_DB_PASSWORD=change-me

# --- JWT / sesiones ---
# Obligatorios, mín. 16 caracteres, y DEBEN ser distintos entre sí.
ACCESS_TOKEN_SECRET=change-me-access-secret-xx
ACCESS_TOKEN_REFRESH_SECRET=change-me-refresh-secret-xx
# Access corto (recomendado producción: 15m). Refresh largo y rotativo.
ACCESS_TOKEN_EXPIRES_IN=15m
ACCESS_TOKEN_REFRESH_EXPIRES_IN=30d


# --- Seed admin (solo bootstrap local) ---
# En producción: SEED_ADMIN_ENABLED=false y NODE_ENV=production (el seed queda bloqueado).
# Si NODE_ENV=production y SEED_ADMIN_ENABLED=true, la API no arranca.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_NOMBRE=Silvana
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe$2026
