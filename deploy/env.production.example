# Ejemplo de /etc/control-stock/api.env (producción)
# chmod 600 · owner: stockapi:stockapi
# NO versionar con secretos reales. Sustituir todos los change-me-*.

# --- App ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Detrás de Nginx (1 hop). Necesario para rate limit / IP real.
TRUST_PROXY=true

# Origen del frontend servido por Nginx (HTTPS)
CORS_ORIGINS=https://api.ejemplo.com
CORS_CREDENTIALS=true

BODY_LIMIT=1mb

# Swagger OFF en producción
SWAGGER_ENABLED=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_REFRESH_LIMIT=15
THROTTLE_SEED_LIMIT=3

# --- MySQL (usuario de aplicación; NO root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=app_stock
DB_PASSWORD=change-me-app-password
DB_NAME=dbcontrolstock
DB_TIMEZONE=-03:00
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Backups (cron como usuario con mysqldump) ---
BACKUP_DIR=/var/www/control-stock/api/backups
BACKUP_RETENTION_DAYS=7
BACKUP_VIA_DOCKER=false
BACKUP_DB_USERNAME=backup_stock
BACKUP_DB_PASSWORD=change-me-backup-password
# BACKUP_EXTERNAL_DIR=/mnt/offsite/control-stock

# --- JWT ---
ACCESS_TOKEN_SECRET=change-me-access-secret-min-16
ACCESS_TOKEN_REFRESH_SECRET=change-me-refresh-secret-min-16
ACCESS_TOKEN_EXPIRES_IN=15m
ACCESS_TOKEN_REFRESH_EXPIRES_IN=30d

# Seed bloqueado en production
SEED_ADMIN_ENABLED=false
